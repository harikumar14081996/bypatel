# ==============================================================================
# byPatel Digital Platform — Production Environment Configuration
# ==============================================================================

# Server Port (default 3001 or provided by your cloud host like Railway/Render/Fly.io)
PORT=3001
NODE_ENV=production

# Database Connection:
# - Leave empty to use local self-hosted SQLite (stored at ./data/bypatel.db)
# - Set to a PostgreSQL connection string (Supabase, Neon, AWS RDS, etc.) for cloud PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Master Admin Credentials (used to access the macOS-style CMS & CRM at /#admin)
ADMIN_EMAIL=info@bypatel.com
ADMIN_PASSWORD=your_secure_production_password_here

# Optional: Email Service Webhook or SMTP (for automated notifications on new leads/job applications)
# NOTIFICATION_EMAIL=info@bypatel.com
# RESEND_API_KEY=re_xxxxxxxxx
